{
  "version": 2,
  "rewrites": [
    { "source": "/api/predictions/active", "destination": "/api/predictions_active" },
    { "source": "/api/predictions/zone/:zoneId", "destination": "/api/predictions_zone" },
    { "source": "/api/zone-status/all", "destination": "/api/zone_status_all" },
    { "source": "/api/safe-zones", "destination": "/api/safe_zones" },
    { "source": "/api/admin/status", "destination": "/api/admin_status" },
    { "source": "/api/alerts/history", "destination": "/api/alerts_history" },
    { "source": "/api/dashboard/summary", "destination": "/api/dashboard_summary" },
    { "source": "/api/alerts/notification-preview", "destination": "/api/alerts_notification_preview" },
    { "source": "/api/push/subscribe", "destination": "/api/push_handler" },
    { "source": "/api/push/unsubscribe", "destination": "/api/push_handler" },
    { "source": "/api/predict/zone/:zoneId", "destination": "/api/ml_predict?type=zone&zoneId=:zoneId" },
    { "source": "/api/predict/resolution/:alertId", "destination": "/api/ml_predict?type=resolution&alertId=:alertId" },
    { "source": "/api/predict/batch", "destination": "/api/ml_predict?type=batch" },
    { "source": "/api/earthquakes", "destination": "/api/map_layers?type=earthquakes" },
    { "source": "/api/rivers", "destination": "/api/map_layers?type=rivers" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-skip-toolbar",
          "value": "1"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://disrupture-prd.vercel.app https://api.tomtom.com;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(), camera=()"
        }
      ]
    }
  ]
}
